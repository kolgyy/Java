<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensetracker.controller.DepartmentFormController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Отдел" style="-fx-font-size: 16px;"/>
    <TextField fx:id="nameField" promptText="Название отдела"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Сохранить" onAction="#handleSave"/>
        <Button text="Отмена" onAction="#handleCancel"/>
    </HBox>
</VBox>
