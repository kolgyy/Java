<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Форма добавления/редактирования сотрудника -->
<?import javafx.geometry.Insets?>
<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensetracker.controller.EmployeeFormController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Информация о сотруднике" style="-fx-font-size: 16px;"/>

    <TextField fx:id="fullNameField" promptText="ФИО"/>
    <ComboBox fx:id="departmentComboBox" promptText="Отдел"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Сохранить" onAction="#handleSave"/>
        <Button text="Отмена" onAction="#handleCancel"/>
    </HBox>
</VBox>
