# Скопируйте в .env и при необходимости измените значения: cp .env.example .env
# Без .env docker compose использует безопасные только для локальной разработки значения по умолчанию.
# Никогда не используйте эти значения за пределами локальной машины.

# --- Порты на хосте ---
FRONTEND_PORT=4200
GATEWAY_PORT=8080
KAFKA_UI_PORT=8090
POSTGRES_PORT=5432

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
AUTH_DB_USER=bibank_auth
AUTH_DB_PASSWORD=change-me-auth
ACCOUNT_DB_USER=bibank_accounts
ACCOUNT_DB_PASSWORD=change-me-accounts
PAYMENT_DB_USER=bibank_payments
PAYMENT_DB_PASSWORD=change-me-payments
LOAN_DB_USER=bibank_loans
LOAN_DB_PASSWORD=change-me-loans
NOTIFICATION_DB_USER=bibank_notifications
NOTIFICATION_DB_PASSWORD=change-me-notifications

# --- Redis / Kafka ---
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Безопасность ---
# Ключ подписи JWT (HS256), не короче 32 байт. Сгенерировать: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Секрет межсервисных вызовов /internal/**
INTERNAL_API_TOKEN=replace-with-another-long-random-secret
JWT_ACCESS_TOKEN_TTL=900s
JWT_REFRESH_TOKEN_TTL=7d

# --- Администратор, создаваемый при первом запуске ---
BIBANK_ADMIN_EMAIL=admin@bibank.local
BIBANK_ADMIN_PASSWORD=Admin12345

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost
