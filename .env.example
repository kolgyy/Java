# LINK-TRACKER PROJECT: .env.example

# BOT MODULE

# Telegram bot token
# Получить у @BotFather в Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# SCRAPPER MODULE

# GitHub API token
# Используется для проверки изменений в репозиториях
GITHUB_TOKEN=your_github_api_token_here

# StackOverflow API key
# Используется для проверки вопросов и ответов
STACKOVERFLOW_KEY=your_stackoverflow_key_here
STACKOVERFLOW_ACCESS_KEY=your_stackoverflow_access_token_here


# GENERAL SETTINGS

# Spring profile: dev, prod
SPRING_PROFILES_ACTIVE=dev

# Протокол коммуникации между модулями
# Возможные значения: grpc, http
COMMUNICATION_PROTOCOL=grpc
